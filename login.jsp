<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>HourGlass | Login</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/hourglass.css"></head>
<body><main class="auth container"><section class="panel"><p class="eyebrow">Campus time-credit exchange</p><h1>Sign in to HourGlass</h1><p class="muted">Use your campus account to request help and manage Time Credits.</p><form class="form" method="post" action="${pageContext.request.contextPath}/hourglass"><input type="hidden" name="action" value="login"><input name="email" type="email" placeholder="College email" required><input name="password" type="password" placeholder="Password" required><button class="button" type="submit">Sign in</button></form><p class="error"><%= request.getAttribute("error") == null ? "" : request.getAttribute("error") %></p></section></main></body></html>
